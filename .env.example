# คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)

# สุ่มค่ายาว ๆ อย่างน้อย 32 ตัวอักษร เช่น: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Google Sign-in: สร้าง OAuth Client ID (Web application) ใน Google Cloud Console
GOOGLE_CLIENT_ID=
# จำกัดเฉพาะอีเมลองค์กร (เว้นว่าง = รับทุกบัญชี Google)
ALLOWED_EMAIL_DOMAIN=
# อีเมลที่จะได้สิทธิ์ผู้ดูแลระบบอัตโนมัติ (คั่นด้วย ,)
ADMIN_EMAILS=

# true = มีปุ่มเข้าระบบแบบทดสอบเลือก role ได้เอง — ต้องเป็น false ใน production
DEV_LOGIN=true
# true เมื่อเปิดใช้ผ่าน HTTPS
COOKIE_SECURE=false

SLA_HOURS=72
MAX_UPLOAD_MB=10

# (ไม่บังคับ) อ่านใบเสร็จอัตโนมัติด้วย Claude API — ตรวจนโยบาย PDPA ขององค์กรก่อนเปิด
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
